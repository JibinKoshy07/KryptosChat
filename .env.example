# ============================================================
# Krypte - Environment Configuration
# Copy this file to `.env` and fill in all values before deploy.
# NEVER commit the real `.env` file. It contains secrets.
# ============================================================

# ------------------------------------------------------------
# General
# ------------------------------------------------------------
# The public origin of the application, used to build absolute URLs
# and for cookie security. Examples:
#   Local (HTTP):        http://localhost
#   Production (HTTPS):  https://chat.example.com
PUBLIC_ORIGIN=http://localhost

# Set to true only when the frontend is served over HTTPS/WSS.
# When true, the session cookie is marked Secure.
# Keep false for plain-HTTP local development.
USE_HTTPS=false

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=krypte
# Connection used by the backend to reach postgres. Host = service name in compose.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_postgres@postgres:5432/krypte

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# Backend secrets (GENERATE STRONG RANDOM VALUES)
# ------------------------------------------------------------
# Used to sign JWT access/refresh tokens. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_jwt_secret
# Session cookie signing/verification key (same JWT secret is reused).
SESSION_SECRET=CHANGE_ME_session_secret

# Access token lifetime (minutes); short-lived.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime (days).
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# Enumeration (message) encryption keys (Base64)
# ------------------------------------------------------------
# Generate:  python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# A 32-byte key is used directly for AES-256-GCM (K_payload).
# A 32-byte master key is used to generate per-message data keys (K_master).
MESSAGE_ENCRYPTION_KEY_BASE64=CHANGE_ME_32_byte_base64_key
MESSAGE_MASTER_KEY_BASE64=CHANGE_ME_32_byte_base64_master_key

# ------------------------------------------------------------
# Media encryption keys (Base64, 32 bytes each)
# ------------------------------------------------------------
# K_media = used to derive per-file keys (K_kdf_master).
# K_settings = used to authenticate the encrypted blob (K_kdf_auth).
#   Generate:  python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MEDIA_KDF_MASTER_KEY_BASE64=CHANGE_ME_32_byte_base64_key
MEDIA_KDF_AUTH_KEY_BASE64=CHANGE_ME_32_byte_base64_key

# ------------------------------------------------------------
# Initial administrator account (created on first backend start)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_DISPLAY_NAME=Administrator

# ------------------------------------------------------------
# Media upload limits
# ------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=104857600
ALLOWED_MEDIA_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,application/pdf,text/plain,application/zip

# ------------------------------------------------------------
# Nginx
# ------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
