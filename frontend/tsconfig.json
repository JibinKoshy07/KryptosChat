{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/.next/types/**/*.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules"],
  "paths": {
    "@/*": ["./src/*"]
  }
}